# ============================================================
# Senior ERP Mirror — oglindire completa (READ-ONLY)
# Copiaza acest fisier ca .env si completeaza valorile.
# ============================================================
ERP_DB_HOST=192.168.1.10
ERP_DB_PORT=1433
ERP_DB_NAME=coralbiogreens
# Recomandat: user SQL cu doar rolul db_datareader
ERP_DB_USER=citire
ERP_DB_PASSWORD=parola_aici
ERP_DB_SSL=false

# Endpoint Coral ERP (nu schimba)
MIRROR_URL=https://yeniohmlmxhjzywqlidx.supabase.co/functions/v1/erp-mirror
# Acelasi token ca la bridge-ul existent
BRIDGE_TOKEN=INLOCUIESTE_CU_TOKENUL

# La cate minute porneste o oglindire completa (tabelele neschimbate sunt sarite)
MIRROR_INTERVAL_MIN=30
# Randuri trimise per lot
CHUNK_SIZE=1000
 # Pauza minima intre loturi (minimum 2000ms); creste automat daca scrierea dureaza.
CHUNK_DELAY_MS=2000

# Optional: filtre pe tabele (separate prin virgula, se accepta * ca wildcard)
# INCLUDE_TABLES=dbo.C_*
EXCLUDE_TABLES=
