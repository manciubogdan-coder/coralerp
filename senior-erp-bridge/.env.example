# ============================================================
# Config Senior ERP Bridge — completează valorile
# ============================================================
# --- Baza de date Senior ERP (SQL Server) ---
ERP_DB_TYPE=mssql
ERP_DB_HOST=192.168.1.10
ERP_DB_PORT=1433
ERP_DB_NAME=coralbiogreens
ERP_DB_USER=citire
ERP_DB_PASSWORD=parola_aici
# SSL/encrypt (de obicei false în LAN)
ERP_DB_SSL=false

# --- Endpoint aplicație Coral ERP (nu schimba dacă nu ți se spune) ---
LOVABLE_INGEST_URL=https://yeniohmlmxhjzywqlidx.supabase.co/functions/v1/ingest-erp-orders
# Token primit de la administrator (îl obții din Lovable — nu-l distribui)
BRIDGE_TOKEN=INLOCUIESTE_CU_TOKENUL

# --- Frecvență poll în milisecunde (2 min = 120000) ---
POLL_INTERVAL_MS=120000

# --- Câte zile în urmă să caute la prima rulare ---
INITIAL_LOOKBACK_DAYS=3
